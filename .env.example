# Application Environment
NODE_ENV=development
APP_PORT=3000
API_PORT=4000
WORKER_PORT=4001
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://sms_api:sms_api_password@localhost:5432/sms
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/sms
DATABASE_WORKER_URL=postgresql://sms_worker:sms_worker_password@localhost:5432/sms
DATABASE_PAYROLL_URL=postgresql://sms_payroll_reader:sms_payroll_reader_password@localhost:5432/sms

# Redis
REDIS_URL=redis://localhost:6379
REDIS_DB_CACHE=0
REDIS_DB_RATELIMIT=1

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sms
KEYCLOAK_CLIENT_ID=sms-api
KEYCLOAK_CLIENT_SECRET=sms-api-secret-key
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
JWT_ISSUER=http://localhost:8080/realms/sms
JWT_AUDIENCE=sms-api
JWKS_CACHE_TTL=3600

# OTP Security
OTP_HASH_SECRET=replace-with-strong-32-char-random-secret

# Gmail SMTP (Requires Google Account 2FA + 16-char App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-college-noreply@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_FROM_NAME="Dhaka Model College"
MAIL_FROM_ADDRESS=your-college-noreply@gmail.com

# Object Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sms-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Payment Aggregator (SSLCommerz / aamarPay)
AGGREGATOR_BASE_URL=https://sandbox.sslcommerz.com
AGGREGATOR_STORE_ID=test_store_id
AGGREGATOR_STORE_PASSWORD=test_store_pass
AGGREGATOR_IPN_SECRET=test_ipn_secret_hmac

# SMS / Notification Provider
SMS_PROVIDER_URL=https://api.sms-gateway.local/v1/send
SMS_PROVIDER_API_KEY=test_sms_key
SMS_SENDER_ID=SMS_INSTITUTE

# Observability
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
