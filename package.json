{
  "name": "sms-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"@sms/*\" dev",
    "dev:nx": "npx nx run-many --target=dev --all --parallel=3",
    "dev:api": "pnpm --filter @sms/api dev",
    "dev:web": "pnpm --filter @sms/web dev",
    "dev:worker": "pnpm --filter @sms/worker dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "db:generate": "pnpm --filter @sms/database db:generate",
    "db:migrate": "pnpm --filter @sms/database db:migrate",
    "db:studio": "pnpm --filter @sms/database db:studio"
  },
  "devDependencies": {
    "@nx/devkit": "^20.0.0",
    "@nx/eslint": "^20.0.0",
    "@nx/eslint-plugin": "^20.0.0",
    "@nx/js": "^20.0.0",
    "@nx/next": "^20.0.0",
    "@nx/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "nx": "^20.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2"
  }
}
